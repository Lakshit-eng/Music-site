# MongoDB connection string
# Local example:      mongodb://127.0.0.1:27017/spellze
# MongoDB Atlas example: mongodb+srv://<user>:<password>@cluster0.mongodb.net/spellze
MONGODB_URI=

# A long, random, secret string used to sign login tokens.
# You can generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# How long a login session stays valid (examples: 1d, 12h, 7d)
JWT_EXPIRES_IN=7d

# Port the API server runs on
PORT=5000

# The URL of the frontend app (used for CORS). Example for local dev:
CLIENT_URL=http://localhost:5173
